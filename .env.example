# OpenAI / Compatible API Configuration (Supports multiple keys separated by comma)
OPENAI_API_KEY=sk-xxxx,sk-yyyy
OPENAI_BASE_URL=https://api.openai.com/v1

# For local LLMs (e.g. vLLM, Ollama), use:
# OPENAI_BASE_URL=http://localhost:8000/v1

# Feishu/Lark Webhook URL for notifications
# LARK_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# Optional Configuration
# MODEL_NAME=gpt-4.1-mini
# DIFF_CHUNK_MAX_CHARS=80000

# Git repository owner whitelist (comma-separated)
# Only repos owned by these users/orgs will be analyzed
# Supports: GitHub, GitLab, Gitee, Bitbucket
# GIT_OWNERS=your-github-username,your-org

# Run mode: online (use AI) or offline (git log only)
# RUN_MODE=online

# Custom prompts file (JSON format with template variables)
# PROMPTS_FILE=prompts.json

# Cache Management
# If true, remove cache entries for commits that no longer exist in Git history
# SYNC_CACHE_WITH_GIT=false

# Report filename format
# Supported variables:
#   {{date}}   - YYYY-MM-DD
#   {{year}}   - YYYY
#   {{month}}  - MM
#   {{repo}}   - Repository name
#   {{owner}}  - Repository owner (from remote URL)
#   {{author}} - Commit author (first author of the day)
# REPORT_FILENAME_FORMAT={{date}}_{{repo}}.md
